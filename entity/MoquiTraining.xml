<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="MoquiTraining" package="moqui" sequence-primary-use-uuid="true" sequence-primary-prefix="MTR_"
            authorize-skip="create">
        <field name="trainingId" type="id" is-pk="true"/>
        <field name="trainingName" type="text-short" not-null="true"/>
        <field name="trainingDate" type="date-time"/>
        <field name="trainingPrice" type="number-decimal"/>
        <field name="trainingDuration"  type="number-integer"/>
        <seed-data>
            <moqui.MoquiTraining trainingName="firstSession" trainingPrice="2999" trainingDuration="10"/>
        </seed-data>
    </entity>
</entities>